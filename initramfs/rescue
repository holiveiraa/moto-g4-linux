#!/bin/sh
# SPDX-License-Identifier: MIT
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
g=/sys/class/android_usb/android0
echo 0 > "$g/enable"
echo 18d1 > "$g/idVendor"
echo 4ee3 > "$g/idProduct"
echo rndis > "$g/functions"
[ ! -e "$g/f_rndis/wceis" ] || echo 1 > "$g/f_rndis/wceis"
echo 1 > "$g/enable"
for iface in rndis0 usb0; do
    [ -d "/sys/class/net/$iface" ] || continue
    ip link set "$iface" up
    ip addr add 172.16.42.1/24 dev "$iface"
    dnsmasq --conf-file=/dev/null --port=0 --no-resolv --user=root --interface="$iface" --bind-interfaces \
        --dhcp-range=172.16.42.2,172.16.42.20,255.255.255.0,12h --dhcp-option=3 --dhcp-option=6 \
        --dhcp-authoritative --dhcp-leasefile=/run/dnsmasq.leases \
        --pid-file=/run/dnsmasq.pid > /run/rescue-dhcp.log 2>&1
    break
done
ip link set lo up
dropbear -F -E -s -r /etc/dropbear/dropbear_ed25519_host_key -p 172.16.42.1:22 > /run/rescue-ssh.log 2>&1 &
while :; do sleep 60; done
